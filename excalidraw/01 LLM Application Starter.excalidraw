    {
      "id": "szl5gQfhYIex0_8DEFmG7",
      "type": "text",
      "x": 558.4679487179492,
      "y": 3489.5865384615363,
      "width": 1906.9942626953125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eaddd7",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0RV",
      "roundness": null,
      "seed": 373643835,
      "version": 31,
      "versionNonce": 163149173,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787505493897,
      "link": null,
      "locked": false,
      "text": "model — Which LLM to use. Different models have different capabilities, context limits, and costs. We'll pick one and use it consistently at first.\n\nmessages — The input to the model. Not a single string — a structured list of messages with roles. This is critical to understand correctly.\n\ntemperature — Controls randomness. 0.0 = deterministic, always picks the most likely token. 1.0 = more creative/unpredictable. For reliable AI systems,\nyou usually want lower temperatures.\n\nmax_tokens — The maximum number of tokens the model can generate in its response. This controls cost and prevents runaway generation.\n\nsystem prompt — A special message that tells the model who it is and how to behave. This is your primary tool for controlling LLM behavior.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "5G922RUJa9gYANG04QC6U",
      "originalText": "model — Which LLM to use. Different models have different capabilities, context limits, and costs. We'll pick one and use it consistently at first.\n\nmessages — The input to the model. Not a single string — a structured list of messages with roles. This is critical to understand correctly.\n\ntemperature — Controls randomness. 0.0 = deterministic, always picks the most likely token. 1.0 = more creative/unpredictable. For reliable AI systems, you usually want lower temperatures.\n\nmax_tokens — The maximum number of tokens the model can generate in its response. This controls cost and prevents runaway generation.\n\nsystem prompt — A special message that tells the model who it is and how to behave. This is your primary tool for controlling LLM behavior.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uHqesDj-Yh6v9De9Wgbla",
      "type": "text",
      "x": 591.4679487179492,
      "y": 4162.086538461536,
      "width": 1676.3552083333334,
      "height": 448.0000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#eaddd7",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
