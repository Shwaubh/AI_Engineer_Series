    {
      "id": "OyGZhT-as3Hc3GPAklDU1",
      "type": "text",
      "x": 575,
      "y": 1483,
      "width": 1514.0000000000002,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#96f2d7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 1901815870,
      "version": 181,
      "versionNonce": 1024964002,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787501697819,
      "link": null,
      "locked": false,
      "text": "LLM\n\nLarge Language Model (LLM) is a type of AI model that has been trained to predict and\ngenerate text.\n\nAt its core, it does one thing:\n\nGiven a sequence of text as input, produce a sequence of text as output.\n\nThat's the primitive. Everything else — chatbots, agents, code generation, reasoning — is\nbuilt on top of this.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM\n\nLarge Language Model (LLM) is a type of AI model that has been trained to predict and generate text.\n\nAt its core, it does one thing:\n\nGiven a sequence of text as input, produce a sequence of text as output.\n\nThat's the primitive. Everything else — chatbots, agents, code generation, reasoning — is built on top of this.",
      "autoResize": false,
      "lineHeight": 1.25
    },
