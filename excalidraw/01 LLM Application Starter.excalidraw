      "seed": 1505530613,
      "version": 83,
      "versionNonce": 1723251035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787505550167,
      "link": null,
      "locked": false,
      "text": "messages = [\n    {\"role\": \"system\",    \"content\": \"You are a helpful assistant.\"},\n    {\"role\": \"user\",      \"content\": \"What is a token?\"},\n    {\"role\": \"assistant\", \"content\": \"A token is a unit of text...\"},\n    {\"role\": \"user\",      \"content\": \"How many tokens is a word?\"},\n]",
      "fontSize": 59.733333333333334,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "messages = [\n    {\"role\": \"system\",    \"content\": \"You are a helpful assistant.\"},\n    {\"role\": \"user\",      \"content\": \"What is a token?\"},\n    {\"role\": \"assistant\", \"content\": \"A token is a unit of text...\"},\n    {\"role\": \"user\",      \"content\": \"How many tokens is a word?\"},\n]",
      "autoResize": true,
      "lineHeight": 1.25
    },
